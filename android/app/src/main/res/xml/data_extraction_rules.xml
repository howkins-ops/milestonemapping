<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules.

  This app holds health, substance-recovery and religious data, plus a Supabase
  session token in SharedPreferences. None of it should leave the device via
  Google's automatic cloud backup, and none of it should ride along in a
  device-to-device transfer without the user re-authenticating.

  Everything server-side already syncs to the user's account, so excluding it
  here costs the user nothing: signing in on a new device restores it properly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
